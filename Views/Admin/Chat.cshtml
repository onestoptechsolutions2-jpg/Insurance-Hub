@using System.Text.Json
@using Insurance_Hub.Services
@model List<Insurance_Hub.Models.ChatMessage>

<div class="a-page-header">
    <div>
        <h1 class="a-page-title">Chat</h1>
        <p class="a-page-sub">Tell me what happened. I'll set it up and you tap to confirm.</p>
    </div>
</div>

<div style="max-width:640px;margin:0 auto">
    <div style="min-height:50vh;padding:12px;border-radius:12px;background:#ece5dd">
        @if (!Model.Any())
        {
            <div style="display:flex;justify-content:flex-start;margin:4px 0">
                <div style="max-width:85%;border-radius:10px;padding:8px 12px;font-size:14px;background:#fff;white-space:pre-line">Hi 👋&#10;&#10;@ViewBag.Help</div>
            </div>
        }
        @foreach (var m in Model)
        {
            var payload = m.FromApp && m.OptionsJson is not null ? JsonSerializer.Deserialize<ChatPayload>(m.OptionsJson) : null;
            <div style="display:flex;justify-content:@(m.FromApp ? "flex-start" : "flex-end");margin:4px 0">
                <div style="max-width:85%;border-radius:10px;padding:8px 12px;font-size:14px;box-shadow:0 1px 1px rgba(0,0,0,.1);background:@(m.FromApp ? "#fff" : "#dcf8c6")">
                    <div style="white-space:pre-line">@m.Text</div>

                    @if (payload is not null && payload.Choices.Count > 0 && !m.Resolved)
                    {
                        <div style="margin-top:8px;display:flex;flex-direction:column;gap:6px">
                            @for (var i = 0; i < payload.Choices.Count; i++)
                            {
                                <form method="post" action="/admin/chat/choose">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="index" value="@i" />
                                    <button style="width:100%;text-align:left;border:1px solid #6366f1;color:#4f46e5;background:#fff;border-radius:999px;padding:8px 14px;font-weight:600;cursor:pointer">
                                        @(payload.Choices.Count == 1 ? "✓ Confirm: " : "")@payload.Choices[i].Label
                                    </button>
                                </form>
                            }
                            <form method="post" action="/admin/chat/cancel">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button style="width:100%;background:none;border:0;color:#6b7280;cursor:pointer;padding:4px">Cancel</button>
                            </form>
                        </div>
                    }
                    @if (payload is not null)
                    {
                        foreach (var l in payload.Links)
                        {
                            <a href="@l.Href" target="@(l.Href.StartsWith("http") ? "_blank" : "_self")" rel="noopener noreferrer"
                               style="display:block;margin-top:6px;text-align:center;background:#1f9d55;color:#fff;border-radius:999px;padding:8px 14px;font-weight:600;text-decoration:none">@l.Label</a>
                        }
                    }
                    <div style="text-align:right;font-size:10px;color:#6b7280;margin-top:4px">@m.CreatedAt.ToString("HH:mm") UTC</div>
                </div>
            </div>
        }
        <div id="chat-end"></div>
    </div>

    <form method="post" action="/admin/chat/send" style="display:flex;gap:8px;position:sticky;bottom:8px;margin-top:8px;padding:6px 0;background:#fff">
        @Html.AntiForgeryToken()
        <input name="text" required maxlength="500" autocomplete="off" autofocus class="a-input"
               style="flex:1;border-radius:999px;padding:10px 16px" placeholder="e.g. Jubilee commission 12000" />
        <button class="a-btn-primary" style="border-radius:999px">Send</button>
    </form>
</div>

<script>document.getElementById('chat-end')?.scrollIntoView({ block: 'end' });</script>
