@* Previous / next links for a long admin list. Controllers set ViewBag.Page and ViewBag.TotalPages. *@
@{
    int currentPage = ViewBag.Page is int ? (int)ViewBag.Page : 1;
    int pageCount = ViewBag.TotalPages is int ? (int)ViewBag.TotalPages : 1;
    var request = ViewContext.HttpContext.Request;

    string Href(int target)
    {
        var parts = new List<string>();
        foreach (var item in request.Query)
        {
            if (string.Equals(item.Key, "page", StringComparison.OrdinalIgnoreCase)) continue;
            parts.Add(Uri.EscapeDataString(item.Key) + "=" + Uri.EscapeDataString(item.Value.ToString()));
        }
        if (target > 1) parts.Add("page=" + target);
        return request.Path.Value + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
}
@if (pageCount > 1)
{
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;font-size:14px">
        @if (currentPage > 1)
        {
            <a class="a-btn-ghost" href="@Href(currentPage - 1)">← Newer</a>
        }
        else
        {
            <span></span>
        }
        <span style="color:#6b7280">Showing set @currentPage of @pageCount</span>
        @if (currentPage < pageCount)
        {
            <a class="a-btn-ghost" href="@Href(currentPage + 1)">Older →</a>
        }
        else
        {
            <span></span>
        }
    </div>
}
